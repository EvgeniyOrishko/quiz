{"props":{"header":{"alt":"","back":true,"counter":false,"image":"/assets/01KM30QR65S97GED41EZZE1N4T_assets_8vgHAulz.webp","progressBar":true,"title":""},"autoNavigation":{"enabled":false}},"elements":[{"id":"el_YeYlV","props":{"__html":"<!--\n  Cognius Insights Teaser — FunnelFox \"Raw HTML\" embed snippet.\n\n  ARCHETYPE FUNNEL COPY — generated from packages/teaser-widget/embed/\n  funnelfox-snippet.html; the only differences are CONFIG_SLUG and this note.\n\n  Paste this into a Raw HTML block on a NEW screen inserted directly after the\n  `q30` screen and before `q31`. It embeds the widget in an iframe, feeds\n  it the answers collected so far via postMessage, and relays the outcome as\n  DOM CustomEvents (`cogniusTeaserCompleted` {insights} / `cogniusTeaserSkipped`\n  {reason}). Funnel routing lives in the clearly-marked listener block at the\n  bottom — edit it freely; the default advances via fox.navigation.goNext().\n\n  The widget NEVER blocks the funnel: an 8s watchdog collapses it and fires\n  `cogniusTeaserSkipped` if it does not show in time. Tune the CONFIG\n  constants below; leave the rest.\n\n  Analytics is funnel-side by design (PostHog is post-funnel only): every\n  outcome goes through `fox.trackCustom` (routed by FunnelFox to Amplitude\n  with the funnel's own identity) — TeaserShown / TeaserInsightRated (verbatim\n  insight text + rating, per card) / TeaserCompleted / TeaserSkipped — and the\n  per-card text+rating is also written into the funnel answers via\n  `fox.inputs.set` (`teaser-insight-N` / `teaser-rating-N`), so it reaches the\n  onboarding webhook with the rest of the answers.\n-->\n<div id=\"cognius-teaser-mount\" style=\"display: flex; justify-content: center\"></div>\n\n<script>\n  (function () {\n    // ── Configure per funnel ────────────────────────────────────────────────\n    var WIDGET_ORIGIN = 'https://teaser.cognius.app';\n    var CONFIG_SLUG = 'archetype'; // teaser config bound to this funnel\n    var SCREEN_ID = 'q30'; // this funnel screen (placement telemetry)\n    var WATCHDOG_MS = 8000; // fail-open: skip if not shown in time\n    var WIDGET_BG = ''; // optional widget background HEX (e.g. '#efece6'); '' = transparent, funnel bg shows through\n    // ────────────────────────────────────────────────────────────────────────\n\n    var mount = document.getElementById('cognius-teaser-mount');\n    if (!mount) return;\n\n    var iframe = document.createElement('iframe');\n    iframe.src = WIDGET_ORIGIN + '/';\n    iframe.title = 'Cognius';\n    iframe.setAttribute('scrolling', 'no');\n    iframe.style.cssText =\n      'width:100%;max-width:440px;height:0;border:0;display:block;background:transparent;';\n    mount.appendChild(iframe);\n\n    var done = false;\n    var shown = false;\n\n    function finish(eventName, detail) {\n      if (done) return;\n      done = true;\n      clearTimeout(watchdog);\n      window.removeEventListener('message', onMessage);\n      window.dispatchEvent(new CustomEvent(eventName, { detail: detail || {} }));\n    }\n\n    // FunnelFox bridges — both guarded so a runtime-API change can only cost\n    // analytics, never the funnel.\n    function track(name, props) {\n      try {\n        if (window.fox && typeof window.fox.trackCustom === 'function') {\n          window.fox.trackCustom(name, props);\n        }\n      } catch (e) {\n        /* ignore */\n      }\n    }\n    function setInput(key, value) {\n      try {\n        if (window.fox && window.fox.inputs && typeof window.fox.inputs.set === 'function') {\n          window.fox.inputs.set(key, value);\n        }\n      } catch (e) {\n        /* ignore */\n      }\n    }\n\n    function skip(reason) {\n      if (done) return;\n      iframe.style.height = '0px';\n      track('TeaserSkipped', { config: CONFIG_SLUG, screen_id: SCREEN_ID, reason: reason });\n      finish('cogniusTeaserSkipped', { reason: reason });\n    }\n\n    // Telemetry-join id. FunnelFox exposes no visitor id on `window.fox`\n    // (state/params are empty — verified live 2026-07-29); the funnel SESSION\n    // ULID is in the page URL as `fsid` and mirrored in the `ff-sess` /\n    // `ff-session` cookies. It is the same funnel-session id the engine\n    // receives in the onboarding webhook, so teaser telemetry joins to the\n    // eventual user. (`fpid` / `ff-user` is the person-level id if ever\n    // needed instead.) Optional — absent id degrades to a per-session uuid.\n    function anonymousId() {\n      try {\n        var fsid = new URLSearchParams(window.location.search).get('fsid');\n        if (fsid) return fsid;\n        var m = document.cookie.match(/(?:^|;\\s*)ff-sess(?:ion)?=([^;]+)/);\n        if (m) return decodeURIComponent(m[1]);\n      } catch (e) {\n        /* ignore */\n      }\n      return undefined;\n    }\n\n    function onMessage(event) {\n      if (event.origin !== WIDGET_ORIGIN) return; // strict origin check\n      var msg = event.data;\n      if (!msg || typeof msg !== 'object') return;\n\n      if (msg.type === 'teaser:ready') {\n        // FunnelFox runtime API: `fox.inputs` is an OBJECT whose `getAll()`\n        // returns the flat custom_id -> value map (verified live 2026-07-29);\n        // the legacy callable form is kept as a fallback.\n        var inputs = {};\n        try {\n          var fi = window.fox && window.fox.inputs;\n          if (fi && typeof fi.getAll === 'function') inputs = fi.getAll() || {};\n          else if (typeof fi === 'function') inputs = fi() || {};\n        } catch (e) {\n          /* ignore — server treats an empty map as a skip */\n        }\n        var initMsg = {\n          type: 'teaser:init',\n          config: CONFIG_SLUG,\n          inputs: inputs,\n          context: { anonymous_id: anonymousId(), screen_id: SCREEN_ID },\n        };\n        if (WIDGET_BG) initMsg.background = WIDGET_BG;\n        iframe.contentWindow.postMessage(initMsg, WIDGET_ORIGIN);\n      } else if (msg.type === 'teaser:resize') {\n        if (!shown) {\n          shown = true;\n          track('TeaserShown', { config: CONFIG_SLUG, screen_id: SCREEN_ID });\n        }\n        clearTimeout(watchdog); // content is up — the watchdog's job is done\n        iframe.style.height = Math.max(0, msg.height | 0) + 'px';\n      } else if (msg.type === 'teaser:rated' && msg.insight) {\n        var ins = msg.insight;\n        track('TeaserInsightRated', {\n          config: CONFIG_SLUG,\n          screen_id: SCREEN_ID,\n          index: ins.index,\n          line_id: ins.line_id,\n          facet: ins.facet,\n          insight: ins.text,\n          rating: ins.rating,\n        });\n        setInput('teaser-insight-' + ins.index, ins.text);\n        setInput('teaser-rating-' + ins.index, ins.rating);\n      } else if (msg.type === 'teaser:completed') {\n        var props = { config: CONFIG_SLUG, screen_id: SCREEN_ID };\n        var list = msg.insights || [];\n        for (var i = 0; i < list.length; i++) {\n          props['insight_' + list[i].index] = list[i].text;\n          props['rating_' + list[i].index] = list[i].rating;\n        }\n        track('TeaserCompleted', props);\n        finish('cogniusTeaserCompleted', { insights: list });\n      } else if (msg.type === 'teaser:skip') {\n        skip(msg.reason || 'skip');\n      }\n    }\n\n    var watchdog = setTimeout(function () {\n      if (!shown) skip('timeout');\n    }, WATCHDOG_MS);\n\n    window.addEventListener('message', onMessage);\n  })();\n\n  // ── Funnel routing — YOUR logic, edit freely ──────────────────────────────\n  // Both outcomes mean the same thing for routing: move on. A skip fires\n  // before anything is visible, so the user simply never sees this screen.\n  window.addEventListener('cogniusTeaserCompleted', function () {\n    fox.navigation.goNext();\n  });\n  window.addEventListener('cogniusTeaserSkipped', function () {\n    fox.navigation.goNext();\n  });\n</script>"},"styles":{"container":{"spacingTop":{"unit":"px","value":16}}},"type":"Raw"}],"hierarchy":{"children":[{"id":"el_YeYlV"}],"id":"__root__"},"styles":{"container":{}},"prefetch":{"images":["/assets/01KM30QR65S97GED41EZZE1N4T_assets_8vgHAulz.webp"],"elementTypes":["Raw"],"checkoutMethods":[]},"id":"UF3vklIu","slug":"insights-teaser","index":37,"customId":"insights-teaser"}