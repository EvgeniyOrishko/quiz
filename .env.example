# Copy to .env for local `vercel dev`; in production set these in Vercel → Project Settings → Environment Variables.
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_MERCHANT_SECRET=
# Amount to charge for the report, in WAYFORPAY_CURRENCY. Required (no default on purpose).
WAYFORPAY_PRICE_REPORT=
WAYFORPAY_CURRENCY=UAH
WAYFORPAY_PRODUCT_NAME=Archetype report
